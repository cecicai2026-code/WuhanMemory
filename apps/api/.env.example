# 后端环境变量。复制本文件为 apps/api/.env 再填写，.env 不会提交到 git。
# 这里的 key 只给后端用，不要写进前端代码。

# 通义千问（阿里云百炼）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 豆包（火山方舟）。DOUBAO_MODEL 填推理接入点的 endpoint ID，以 ep- 开头
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=

# 高德。Web 服务 key 用于路线规划；安全密钥是 JS key 配套的那一个，只放后端
AMAP_WEB_SERVICE_KEY=
AMAP_SECURITY_JS_CODE=

# 默认使用哪个模型：mock、qwen 或 doubao
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=
LLM_PROVIDER_MODE=fixed
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# 本地 SQLite 数据库文件，路径相对于 apps/api（见 ADR 0003）
DATABASE_URL=sqlite:///./wuhanmemory.db

# 前端网址，用于生成分享链接和跨域设置
PUBLIC_APP_URL=http://localhost:3000
