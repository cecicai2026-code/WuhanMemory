# 后端环境变量。复制本文件为 apps/api/.env 再填写，.env 不会提交到 git。
# 这里的 key 只给后端用，不要写进前端代码。

# 通义千问（阿里云百炼）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 豆包（火山方舟）。DOUBAO_MODEL 填推理接入点的 endpoint ID，以 ep- 开头
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
# 豆包的深度思考：留空用模型自己的默认值；enabled 强制思考；disabled 不思考（更快，更省 token）
# 2026-11-15 Cecilia 决定关掉：开着时排行程每次都超过 60 秒的超时
DOUBAO_THINKING=disabled

# 高德。Web 服务 key 用于路线规划；安全密钥是 JS key 配套的那一个，只放后端
AMAP_WEB_SERVICE_KEY=
AMAP_SECURITY_JS_CODE=

# 默认使用哪个模型：qwen 或 doubao。每次请求和界面上也可以另外选
# LLM_FALLBACK_PROVIDER 和 LLM_PROVIDER_MODE=fallback 是"默认模型失败时自动换另一个"，默认不开
LLM_PROVIDER=qwen
LLM_FALLBACK_PROVIDER=
LLM_PROVIDER_MODE=fixed
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# 本地 SQLite 数据库文件，路径相对于 apps/api（见 ADR 0003）
DATABASE_URL=sqlite:///./wuhanmemory.db

# 前端网址，用于生成分享链接和跨域设置
PUBLIC_APP_URL=http://localhost:3000

# ---------- 公开模式（板块 7）：网站给别人用时打开，本机开发时保持 false ----------
# 打开后：占位照片不对外；我的行程、生成和撤回分享链接要口令；规划和对比限次数。见 app/core/site_policy.py
PUBLIC_MODE=false
# 网站主人的口令（自己定一串不好猜的，不要和别的密码相同）。公开模式下不设，就关掉我的行程和分享管理
OWNER_PASSCODE=
# 公开模式下的试用次数：同一个地址每小时几次、全站每天几次（对比一次算 2 次）。带口令的不限
RATE_PER_CLIENT_PER_HOUR=5
RATE_PER_DAY=50
# 网站前面有反向代理或隧道时改成 true，用代理传来的访客地址；没有代理时保持 false
TRUST_PROXY_HEADERS=false
