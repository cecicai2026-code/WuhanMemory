# 前端环境变量。复制本文件为 apps/web/.env.local 再填写，.env.local 不会提交到 git。
# NEXT_PUBLIC_ 开头的变量会出现在浏览器里，所以这里只能放高德 JS key，不能放其他 key。

# 高德 Web 端（JS API）key
NEXT_PUBLIC_AMAP_JS_KEY=

# 后端地址，只在网站的服务器上用（转发接口、服务器端取数据），不会进浏览器。
# 浏览器只连网站自己的地址，/api、/_AMapService、/media 由网站转给后端（2026-11-15 为上线改的）。
# 以前的 NEXT_PUBLIC_API_BASE_URL、NEXT_PUBLIC_APP_URL 不再用了，.env.local 里留着也没关系。
API_BASE_URL=http://localhost:8000
