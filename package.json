{
  "name": "wuhanmemory",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "corepack pnpm --filter @wuhanmemory/web dev",
    "dev:web": "corepack pnpm --filter @wuhanmemory/web dev",
    "dev:api": "cd apps/api && .venv/bin/python -m uvicorn app.main:app --reload --port 8000",
    "start:web": "cd apps/web && ./node_modules/.bin/next start --port 3000",
    "start:api": "cd apps/api && .venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "build": "corepack pnpm --filter @wuhanmemory/shared build && corepack pnpm --filter @wuhanmemory/map-core build && corepack pnpm --filter @wuhanmemory/web build",
    "lint": "corepack pnpm --filter @wuhanmemory/shared lint && corepack pnpm --filter @wuhanmemory/map-core lint && corepack pnpm --filter @wuhanmemory/web lint",
    "typecheck": "corepack pnpm --filter @wuhanmemory/shared typecheck && corepack pnpm --filter @wuhanmemory/map-core typecheck && corepack pnpm --filter @wuhanmemory/web typecheck",
    "test": "corepack pnpm typecheck",
    "test:api": "cd apps/api && .venv/bin/python -m pytest",
    "check:data": "cd apps/api && .venv/bin/python -m app.data_quality",
    "amap:lookup": "cd apps/api && .venv/bin/python -m app.tools.amap_lookup",
    "llm:smoke": "cd apps/api && .venv/bin/python -m app.tools.llm_smoke",
    "plan:thinking": "cd apps/api && .venv/bin/python -m app.tools.thinking_compare",
    "routes:prewarm": "cd apps/api && .venv/bin/python -m app.tools.route_prewarm",
    "eval:run": "cd apps/api && .venv/bin/python -m app.tools.model_eval",
    "eval:order": "cd apps/api && .venv/bin/python -m app.tools.order_eval",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.6.3",
    "typescript": "^6.0.3"
  }
}
